# ─────────── IA (opcional: sin clave, el pipeline usa reglas y plantillas) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─────────── Identidad del remitente ───────────
SENDER_NAME=Felipe
# Va en la firma del CORREO. Sin credenciales académicas: la regla 4 del PROMPT
# las prohíbe expresamente ("la autoridad la dan el hallazgo medido y la
# evidencia, no un título"), y `prospector lint` avisa si se cuela una.
SENDER_ROLE=Diseño y CRO de landing pages
# Cómo te presentás en WHATSAPP, en seis palabras. Reemplaza a la firma: en ese
# canal el nombre y el número ya están en el encabezado del chat.
SENDER_PITCH=armo páginas web
SENDER_SITE=
# Prueba social REAL para el correo (opcional). Si la completás, tiene que ser
# verificable — nunca se inventa una referencia. Ejemplo:
# SENDER_PROOF=la última que hice fue para un estudio contable acá en La Plata
SENDER_PROOF=
REPLY_TO=

# ─────────── SMTP (usa una contraseña de aplicación, nunca la del correo) ───────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─────────── Ritmo de envío (reputación del dominio) ───────────
MAIL_DAILY_CAP=30
MAIL_JITTER_MIN_S=360
MAIL_JITTER_MAX_S=840
MAIL_WINDOW_START=9
MAIL_WINDOW_END=19
MAIL_SKIP_WEEKENDS=true

# ─────────── WhatsApp (canal manual) ───────────
# Acá pasarse no cuesta entregabilidad, cuesta el número, con los chats adentro
# y sin apelación. Pero lo que dispara un bloqueo es volumen × texto repetido ×
# reportes, no el volumen solo. Señal de alarma: mensajes que quedan en un
# tilde cuando antes llegaban. Si aparece, bajalo.
WA_DAILY_CAP=50
WA_WINDOW_START=10
WA_WINDOW_END=19
WA_SKIP_WEEKENDS=true
WA_COUNTRY_CODE=54          # prefijo para teléfonos sin código de país

# ─────────── Minado ───────────
MINE_MAX_LEADS=40
MINE_MAX_SCROLLS=8
MINE_INCLUDE_WITHOUT_SITE=true

# ─────────── Auditoría ───────────
AUDIT_CONCURRENCY=3
AUDIT_MIN_SCORE=28          # por debajo de esto, la web es sana/funcional y se descarta
AUDIT_VISION_THRESHOLD=55   # solo se paga IA cuando ya hay señales fuertes de que pierde clientes
AUDIT_USE_VISION=true
AUDIT_ANNOTATE=true
HEADLESS=true
