---
interface Props {
  title: string;
  description: string;
  ctaText: string;
  ctaLink: string;
  imagePath: string;
}

const { title, description, ctaText, ctaLink, imagePath } = Astro.props;
---

<section class="hero-section" style={`background-image: linear-gradient(180deg, rgba(5,20,36,0.88) 0%, rgba(5,20,36,0.98) 100%), url('${imagePath}');`}>
  <div class="container hero-content fade-in">
    <span class="hero-badge">Odontología Integral Especializada</span>
    <h1 id="hero-title">{title}</h1>
    <p class="hero-description">{description}</p>
    
    <div class="hero-actions">
      <a 
        href={ctaLink} 
        class="btn btn-primary cta-button" 
        aria-label={ctaText}
        target="_blank"
        rel="noopener noreferrer"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    background-color: var(--navy-deep);
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 0 6rem;
    position: relative;
    border-bottom: none; /* Eliminado para transición más limpia al contenido blanco */
  }

  .hero-content {
    max-width: 900px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal);
    border: 1px solid rgba(45, 212, 191, 0.4);
    padding: 8px 24px;
    border-radius: 2px;
    margin-bottom: 2rem;
    background: rgba(5, 20, 36, 0.5); /* Fondo oscuro propio para separar de cualquier luz residual */
  }

  h1 {
    color: #ffffff; /* Blanco absoluto */
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 20px rgba(0,0,0,0.8); /* Sombra severa para contraste forzado */
  }

  .hero-description {
    font-family: var(--font-sans);
    font-weight: 500; /* Mayor peso tipográfico */
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.7;
    margin: 0 0 3.5rem 0;
    max-width: 680px;
    color: #ffffff; /* Blanco absoluto */
    text-shadow: 0 2px 10px rgba(0,0,0,0.9); /* Sombra agresiva para no perderse contra texturas arquitectónicas */
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .cta-button {
    background-color: var(--teal);
    color: var(--navy-deep);
    font-weight: 700; /* CTA con más autoridad */
    font-size: 1.15rem;
    padding: 1.25rem 3rem;
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(45, 212, 191, 0.3);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(45, 212, 191, 0.4);
    background-color: #34d399;
  }
</style>