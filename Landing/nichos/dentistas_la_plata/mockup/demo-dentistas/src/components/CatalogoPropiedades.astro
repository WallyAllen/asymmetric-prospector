---
interface Propiedad {
  title: string;
  specs: string;
  imagePath: string;
}

interface Props {
  title: string;
  items: Propiedad[];
}
const { title, items } = Astro.props;
---
<section class="catalogo-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">{title}</h2>
      <p class="section-subtitle">Acceso restringido a piezas arquitectónicas fuera del mercado público.</p>
    </div>

    <div class="catalogo-grid">
      {items.map(prop => (
        <article class="prop-card">
          <div class="prop-image-wrapper">
            <img src={prop.imagePath} alt={prop.title} loading="lazy" />
          </div>
          <div class="prop-content">
            <h3 class="prop-title">{prop.title}</h3>
            <p class="prop-specs">{prop.specs}</p>
            <a href="#filtro" class="prop-link">Solicitar Dossier <span class="arrow">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .catalogo-section {
    background-color: #18181B; /* Dark background */
    padding: 8rem 0;
    color: #FAFAFA;
  }
  .section-header { margin-bottom: 5rem; }
  .section-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; font-weight: 400; color: #E4B363; }
  .section-subtitle { color: #A1A1AA; font-size: 1.1rem; letter-spacing: 0.05em; text-transform: uppercase; }

  /* CSS Grid Perfecto */
  .catalogo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 3rem; /* Espaciado generoso */
  }

  .prop-card {
    background-color: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    height: 500px; /* Fijo para proporciones perfectas */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.4s ease;
  }
  
  .prop-card:hover { border-color: rgba(228, 179, 99, 0.4); }

  /* 70% Imagen */
  .prop-image-wrapper {
    height: 70%;
    width: 100%;
    overflow: hidden;
    background-color: #000;
  }
  .prop-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Animación Suave Escala 1.03 */
  .prop-card:hover .prop-image-wrapper img {
    transform: scale(1.03);
  }

  /* 30% Texto */
  .prop-content {
    height: 30%;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .prop-title { font-size: 1.3rem; margin: 0; font-family: var(--font-serif); font-weight: 500; color: #FAFAFA; }
  .prop-specs { font-size: 0.85rem; color: #A1A1AA; margin: 0.5rem 0 0 0; letter-spacing: 0.05em; }
  
  .prop-link {
    font-size: 0.85rem;
    color: #E4B363;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.3s ease;
  }
  .prop-link:hover { opacity: 0.8; }
  .arrow { margin-left: 0.5rem; transition: transform 0.3s ease; }
  .prop-card:hover .arrow { transform: translateX(5px); }

  @media (max-width: 768px) {
    .catalogo-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
