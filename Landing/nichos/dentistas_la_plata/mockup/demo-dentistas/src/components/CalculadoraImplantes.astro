---
interface Props {
  title: string;
  description: string;
  precioTotal: number;
  numeroWa: string;
}
const { title, description, precioTotal, numeroWa } = Astro.props;
---
<section 
  class="calculator-section" 
  aria-labelledby="calc-title"
  data-precio={precioTotal} 
  data-wa={numeroWa}
>
  <div class="container calculator-container">
    <div class="calculator-card">
      <h2 id="calc-title">{title}</h2>
      <p class="calc-description">{description}</p>
      
      <div class="slider-group">
        <label for="anticipo-slider" class="slider-label">
          Porcentaje de Anticipo: <span id="anticipo-porcentaje">30</span>%
        </label>
        <input type="range" id="anticipo-slider" class="range-slider" min="10" max="50" step="5" value="30" aria-valuemin="10" aria-valuemax="50" aria-valuenow="30" />
        
        <div class="results-grid">
          <div class="result-box">
            <span class="result-title">Pago Inicial (Hoy)</span>
            <span class="result-value" id="anticipo-monto">$0</span>
          </div>
          <div class="result-box highlight">
            <span class="result-title">12 Cuotas Fijas de</span>
            <span class="result-value accent" id="cuota-monto">$0</span>
          </div>
        </div>
      </div>

      <a href="#" id="whatsapp-cta" class="cta-button" target="_blank" rel="noopener noreferrer">
        Bloquear esta tarifa por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .calculator-section {
    background-color: var(--paper); /* Transición a claro para el cierre */
    padding: 8rem 0;
    display: flex;
    justify-content: center;
  }

  .calculator-container {
    display: flex;
    justify-content: center;
  }

  .calculator-card {
    width: 100%;
    max-width: 650px;
    background-color: #ffffff;
    padding: 4rem 3rem;
    border-radius: 8px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    border-top: 4px solid var(--teal);
    text-align: center;
  }

  h2 {
    color: var(--navy-deep);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    font-weight: 700;
  }

  .calc-description {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    margin: 0 0 3rem;
  }

  .slider-group {
    margin-bottom: 3rem;
    text-align: left;
  }

  .slider-label {
    display: block;
    color: var(--navy-deep);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .range-slider {
    width: 100%;
    accent-color: var(--teal);
    margin-bottom: 3rem;
    cursor: pointer;
    height: 6px;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .result-box {
    background-color: var(--paper);
    padding: 1.5rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--border-subtle);
  }

  .result-box.highlight {
    background-color: rgba(45, 212, 191, 0.05);
    border-color: rgba(45, 212, 191, 0.3);
  }

  .result-title {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .result-value {
    color: var(--navy-deep);
    font-family: var(--font-sans);
    font-size: 1.8rem;
    font-weight: 800;
  }

  .result-value.accent {
    color: #0d9488; /* Teal alto contraste */
  }

  .cta-button {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    background-color: var(--teal);
    color: var(--navy-deep);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    padding: 1.25rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(45, 212, 191, 0.3);
    background-color: #34d399;
  }
  
  @media (max-width: 600px) {
    .results-grid { grid-template-columns: 1fr; }
    .calculator-card { padding: 2rem 1.5rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.calculator-section');
    if(!section) return;
    
    // Obtener variables inyectadas de Astro Props
    const PRECIO_TOTAL = Number(section.getAttribute('data-precio')) || 0;
    const NUMERO_WA = section.getAttribute('data-wa') || ""; 
    
    const slider = document.getElementById('anticipo-slider');
    const percDisplay = document.getElementById('anticipo-porcentaje');
    const anticipoDisplay = document.getElementById('anticipo-monto');
    const cuotaDisplay = document.getElementById('cuota-monto');
    const cta = document.getElementById('whatsapp-cta');

    const formatARS = (num) => {
      return new Intl.NumberFormat('es-AR', {
        style: 'currency',
        currency: 'ARS',
        maximumFractionDigits: 0
      }).format(num);
    };

    const calculateValues = () => {
      const porcentaje = parseInt(slider.value, 10);
      const anticipo = PRECIO_TOTAL * (porcentaje / 100);
      const saldo = PRECIO_TOTAL - anticipo;
      const cuota = saldo / 12;

      percDisplay.textContent = porcentaje;
      anticipoDisplay.textContent = formatARS(anticipo);
      cuotaDisplay.textContent = formatARS(cuota);

      slider.setAttribute('aria-valuenow', porcentaje);

      const mensaje = `Hola, quiero evaluar el plan de implantes entregando un anticipo de ${formatARS(anticipo)} y 12 cuotas de ${formatARS(cuota)}.`;
      cta.href = `https://wa.me/${NUMERO_WA}?text=${encodeURIComponent(mensaje)}`;
    };

    slider.addEventListener('input', calculateValues);
    calculateValues(); // Init run
  });
</script>