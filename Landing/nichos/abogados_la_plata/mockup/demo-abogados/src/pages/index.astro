---
import '../styles/global.css';
import HeroLegalART from '../components/HeroLegalART.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProcessLegal from '../components/ProcessLegal.astro';
import { abogadosData } from '../data/demos/abogados.js';

const { seo, hero, trust, process } = abogadosData;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={seo.description}>
    <title>{seo.title}</title>
</head>
<body>
    <main>
        <!-- 1. FOLD VISUAL IMPONENTE -->
        <HeroLegalART 
            title={hero.title}
            description={hero.description}
            ctaText={hero.ctaText}
            ctaLink={hero.ctaLink}
            imagePath={hero.imagePath}
        />
        
        <!-- 2. AUTORIDAD (Tema Dorado) -->
        <TrustBadges badges={trust.badges} theme="gold" />

        <!-- 3. PROCESO MINIMALISTA -->
        <ProcessLegal 
            title={process.title}
            subtitle={process.subtitle}
            steps={process.steps}
        />
    </main>
</body>
</html>
