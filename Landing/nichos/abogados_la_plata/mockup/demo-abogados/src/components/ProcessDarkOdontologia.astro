---
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle: string;
  steps: Step[];
}

const { title, subtitle, steps } = Astro.props;
---

<section class="process-dark section-padding">
  <div class="container">
    <div class="process-header">
      <span class="section-label">Nuestro Método</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-subtitle">{subtitle}</p>
    </div>

    <div class="process-grid">
      {steps.map((step) => (
        <div class="process-card">
          <div class="step-number">{step.number}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-dark {
    background-color: var(--navy-deep);
    color: var(--paper);
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 8rem 0;
  }

  .process-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 1rem;
  }

  .section-title {
    color: var(--paper);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .section-subtitle {
    color: rgba(248, 250, 252, 0.7);
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  .process-card {
    position: relative;
    padding: 2rem 0;
  }

  .process-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background-color: var(--teal);
  }

  .step-number {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    font-weight: 700;
    color: rgba(255,255,255,0.05); /* Número enorme como marca de agua elegante */
    line-height: 1;
    margin-bottom: -1rem;
    position: relative;
    z-index: 1;
  }

  .step-title {
    color: var(--paper);
    font-size: 1.4rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .step-desc {
    color: rgba(248, 250, 252, 0.7);
    font-size: 1rem;
    line-height: 1.7;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
