---
interface Props {
  title: string;
  description: string;
  ctaText: string;
  ctaLink: string;
  imagePath: string;
}

const { title, description, ctaText, ctaLink, imagePath } = Astro.props;
---

<section class="hero-section" style={`background-image: linear-gradient(90deg, rgba(15,15,24,0.95) 0%, rgba(15,15,24,0.85) 50%, rgba(15,15,24,0.3) 100%), url('${imagePath}');`}>
  <div class="container hero-content fade-in">
    <span class="hero-badge">Boutique Inmobiliaria Exclusiva</span>
    <h1 id="hero-title">{title}</h1>
    <p class="hero-description">{description}</p>
    
    <div class="hero-actions">
      <a 
        href={ctaLink} 
        class="btn btn-primary cta-button" 
        aria-label={ctaText}
        target="_blank"
        rel="noopener noreferrer"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    background-color: #0f0f18; /* Negro profundo para base */
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 8rem 0 6rem;
    position: relative;
  }

  .hero-content {
    max-width: 750px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-muted);
    border: 1px solid rgba(196, 169, 119, 0.4);
    padding: 8px 24px;
    border-radius: 2px;
    margin-bottom: 2rem;
    background: rgba(15, 15, 24, 0.6);
  }

  h1 {
    color: #ffffff;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 20px rgba(0,0,0,0.9);
    text-wrap: balance;
  }

  .hero-description {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.8vw, 1.25rem);
    line-height: 1.7;
    margin: 0 0 3.5rem 0;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0,0,0,1);
    text-wrap: pretty;
  }

  .cta-button {
    background-color: var(--gold-muted);
    color: #0f0f18; /* Botón oscuro, muy elegante */
    font-weight: 700;
    font-size: 1.15rem;
    padding: 1.25rem 3rem;
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(196, 169, 119, 0.3);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(196, 169, 119, 0.4);
    background-color: #d8bc88;
  }
</style>