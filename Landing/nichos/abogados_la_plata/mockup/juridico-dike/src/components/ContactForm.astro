---
import { estudio } from '../data/estudio.js';
---

<section id="contacto" class="section-padding">
  <div class="container contact-container">
    <div class="contact-info">
      <h2 class="section-title">Contáctenos</h2>
      <p class="section-subtitle" style="margin-left:0; text-align:left;">Complete el formulario y le responderemos a la brevedad por WhatsApp.</p>
      
      <div class="info-blocks">
        <div class="info-block">
          <strong>Dirección</strong>
          <p>{estudio.direccion}</p>
          <p>{estudio.ciudad}, {estudio.provincia}</p>
        </div>
        
        <div class="info-block">
          <strong>Horario de Atención</strong>
          <p>{estudio.horario}</p>
          {estudio.requiereTurno && <p><em>* Solo con turno previo</em></p>}
        </div>
        
        <div class="info-block">
          <strong>Teléfonos</strong>
          <p><a href={`tel:${estudio.telefono}`}>{estudio.telefonoDisplay}</a></p>
          {estudio.telefonoAlt && <p><a href={`tel:${estudio.telefonoAlt}`}>{estudio.telefonoAltDisplay}</a></p>}
        </div>
      </div>
    </div>
    
    <div class="contact-form-wrapper">
      <form id="wa-form" class="wa-form">
        <div class="form-group">
          <label for="nombre">Nombre completo</label>
          <input type="text" id="nombre" name="nombre" required placeholder="Ej: Juan Pérez" />
        </div>
        
        <div class="form-group">
          <label for="tel">Teléfono</label>
          <input type="tel" id="tel" name="tel" required placeholder="Ej: 221 555-1234" />
        </div>
        
        <div class="form-group">
          <label for="caso">Describa brevemente su caso</label>
          <textarea id="caso" name="caso" rows="4" required placeholder="Me despidieron y quiero saber qué me corresponde..."></textarea>
        </div>
        
        <button type="submit" class="btn btn-primary submit-btn">
          Enviar por WhatsApp
        </button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumber: estudio.whatsapp }}>
  document.getElementById('wa-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const nombre = document.getElementById('nombre').value;
    const tel = document.getElementById('tel').value;
    const caso = document.getElementById('caso').value;
    
    const mensaje = `Hola, soy ${nombre} (Tel: ${tel}). Quiero consultar sobre: ${caso}`;
    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
    
    window.open(url, '_blank');
  });
</script>

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .info-blocks {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .info-block strong {
    display: block;
    color: var(--navy);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .info-block p {
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .contact-form-wrapper {
    background-color: #ffffff;
    padding: 2.5rem;
    border-radius: 8px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    border-top: 4px solid var(--gold-muted);
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--navy);
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--gold-muted);
  }
  .submit-btn {
    width: 100%;
    font-size: 1.125rem;
    padding: 1rem;
  }
  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
    }
  }
</style>
