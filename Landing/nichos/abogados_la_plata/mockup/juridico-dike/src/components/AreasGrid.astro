---
import { estudio } from '../data/estudio.js';
---

<section id="areas" class="section-padding">
  <div class="container">
    <div class="text-center">
      <h2 class="section-title">Áreas de Práctica</h2>
      <p class="section-subtitle">Soluciones estratégicas para cada conflicto legal.</p>
    </div>
    
    <div class="areas-grid">
      {estudio.areas.map(area => (
        <div class="area-card">
          <h3 class="area-title">{area.nombre}</h3>
          <p class="area-desc">{area.descripcion}</p>
          <a href={estudio.whatsappUrl(estudio.mensajesWhatsapp.area(area.nombre))} target="_blank" rel="noopener noreferrer" class="area-link">
            Consultar caso &rarr;
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }
  .area-card {
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border-top: 4px solid var(--gold-muted);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .area-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .area-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--navy);
  }
  .area-desc {
    color: var(--muted);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  .area-link {
    color: var(--whatsapp);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
    align-self: flex-start;
    margin-top: auto;
  }
  .area-link:hover {
    color: var(--navy);
  }
  .area-card {
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border-top: 4px solid var(--gold-muted);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
</style>
