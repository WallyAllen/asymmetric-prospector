---
import { estudio } from '../data/estudio.js';
const hasTestimonios = estudio.testimonios && estudio.testimonios.length > 0;
---

{hasTestimonios && (
  <section class="section-padding testimonials-section">
    <div class="container">
      <div class="text-center">
        <h2 class="section-title">Lo que dicen nuestros clientes</h2>
        {estudio.ratingPromedio && (
          <p class="section-subtitle">
            Valorados con {estudio.ratingPromedio} ★ en Google ({estudio.totalOpiniones} opiniones)
          </p>
        )}
      </div>
      
      <div class="testimonials-grid">
        {estudio.testimonios.map((testimonio: any) => (
          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"{testimonio.texto}"</p>
            <p class="author">— {testimonio.autor}</p>
          </div>
        ))}
      </div>
      
      {estudio.googleMapsUrl && (
        <div class="text-center" style="margin-top: 3rem;">
          <a href={estudio.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">
            Leer más opiniones en Google
          </a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .testimonials-section {
    background-color: #f1f5f9;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .testimonial-card {
    background-color: var(--paper);
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid var(--navy);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  .stars {
    color: #f59e0b;
    font-size: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }
  .quote {
    font-style: italic;
    margin-bottom: 1.5rem;
    color: var(--text-dark);
  }
  .author {
    font-weight: 600;
    color: var(--navy);
  }
  .btn-outline-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
    background-color: transparent;
    color: var(--navy-deep);
    border: 1px solid var(--navy-deep);
  }
  .btn-outline-dark:hover {
    background-color: var(--navy-deep);
    color: var(--paper);
  }
</style>
