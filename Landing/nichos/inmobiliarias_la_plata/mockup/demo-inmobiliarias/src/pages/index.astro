---
import '../styles/global.css';
import HeroInmobiliaria from '../components/HeroInmobiliaria.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProcessInmobiliaria from '../components/ProcessInmobiliaria.astro';
import CatalogoPropiedades from '../components/CatalogoPropiedades.astro';
import { inmobiliariasData } from '../data/demos/inmobiliarias.js';

const { seo, hero, trust, process, catalogo } = inmobiliariasData;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={seo.description}>
    <title>{seo.title}</title>
</head>
<body style="background-color: #18181B;">
    <main>
        <!-- 1. FOLD VISUAL IMPONENTE -->
        <HeroInmobiliaria 
            title={hero.title}
            description={hero.description}
            ctaText={hero.ctaText}
            ctaLink={hero.ctaLink}
            imagePath={hero.imagePath}
        />
        
        <!-- 2. AUTORIDAD (Tema Dorado) -->
        <TrustBadges badges={trust.badges} theme="gold" />
        
        <!-- 3. COLECCIÓN PRIVADA (Catálogo Curado) -->
        <CatalogoPropiedades title={catalogo.title} items={catalogo.items} />

        <!-- 4. PROCESO / MÉTODO DE TRABAJO -->
        <ProcessInmobiliaria 
            title={process.title}
            subtitle={process.subtitle}
            steps={process.steps}
        />
    </main>
</body>
</html>
