---
import { estudio } from '../data/estudio.js';

const legalServiceSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LegalService"],
  "name": estudio.nombre,
  "description": estudio.descripcion,
  "url": estudio.seo.canonical,
  "telephone": estudio.telefono,
  "email": estudio.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": estudio.direccion,
    "addressLocality": estudio.ciudad,
    "addressRegion": estudio.provincia,
    "postalCode": estudio.codigoPostal,
    "addressCountry": "AR"
  },
  "areaServed": {
    "@type": "City",
    "name": estudio.zona
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Áreas de Práctica Legal",
    "itemListElement": estudio.areas.map((area, index) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": area.nombre,
        "description": area.descripcion
      },
      "position": index + 1
    }))
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": estudio.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.respuesta
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
