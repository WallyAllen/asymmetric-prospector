---
interface Props {
  numeroWa: string;
}
const { numeroWa } = Astro.props;
---
<section class="calc-section section-padding">
  <div class="container calc-container">
    <div class="calc-card" data-wa={numeroWa}>
      <!-- FASE 1: INGRESO DE DATOS -->
      <div id="calc-step-1" class="calc-step active">
        <div class="calc-header">
          <span class="calc-badge">Evaluación Confidencial</span>
          <h2 class="calc-title">Simulador de Indemnización</h2>
          <p class="calc-desc">Calcula el piso mínimo garantizado de tu liquidación por despido o accidente, actualizado según la jurisprudencia laboral vigente.</p>
        </div>
        
        <div class="calc-form">
          <div class="form-group">
            <label for="sueldo">Mejor Sueldo Percibido (ARS)</label>
            <input type="number" id="sueldo" placeholder="Ej: 850000" min="0" required />
          </div>
          <div class="form-group">
            <label for="antiguedad">Años de Antigüedad</label>
            <input type="number" id="antiguedad" placeholder="Ej: 5" min="0" required />
          </div>
          <button id="btn-calcular" class="btn-primary mt-4">Calcular mi Indemnización</button>
        </div>
      </div>

      <!-- FASE 2: TRUCO DE CARGA (SPINNER) -->
      <div id="calc-step-2" class="calc-step">
        <div class="spinner-container">
          <div class="spinner"></div>
          <p class="spinner-text">Analizando jurisprudencia y actualizando montos...</p>
        </div>
      </div>

      <!-- FASE 3: CIERRE DE BUCLE (NURTURING/LEAD TRAP) -->
      <div id="calc-step-3" class="calc-step">
        <div class="success-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <h3 class="calc-title">Cálculo Preliminar Completado</h3>
        <p class="calc-desc success-desc">
          Por estricta normativa de confidencialidad profesional, no publicamos estimaciones financieras en pantalla abierta. El resultado exacto ha sido calculado y se entregará por un canal seguro.
        </p>
        <button id="btn-whatsapp" class="btn-primary btn-wa">
          Recibir liquidación cifrada por WhatsApp
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-section { 
    background-color: #0B1120;
    padding: 8rem 0; 
    display: flex; 
    justify-content: center;
    border-top: 1px solid rgba(255,255,255,0.03);
  }
  .calc-container { display: flex; justify-content: center; width: 100%; }
  
  .calc-card {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    width: 100%;
    max-width: 580px;
    padding: 4rem 3.5rem;
    border-radius: 4px;
    text-align: center;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .calc-step { display: none; opacity: 0; transition: opacity 0.4s ease; }
  .calc-step.active { display: block; opacity: 1; animation: fadeIn 0.5s ease forwards; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .calc-badge { display: inline-block; color: #C5A059; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; border: 1px solid rgba(197, 160, 89, 0.25); padding: 4px 14px; border-radius: 2px; margin-bottom: 1.5rem; background: rgba(197, 160, 89, 0.06); }
  .calc-title { color: #F9FAFB; font-family: var(--font-serif); font-size: 2rem; margin-bottom: 1rem; line-height: 1.2; font-weight: 700; }
  .calc-desc { color: #8892B0; font-size: 1rem; margin-bottom: 2.5rem; line-height: 1.6; }
  
  .form-group { text-align: left; margin-bottom: 1.5rem; }
  .form-group label { display: block; color: #F9FAFB; margin-bottom: 0.5rem; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; }
  
  .form-group input { 
    width: 100%; 
    padding: 1.1rem; 
    background-color: rgba(255, 255, 255, 0.03); 
    border: 1px solid rgba(255, 255, 255, 0.08); 
    color: #fff; 
    border-radius: 2px; 
    font-size: 1rem; 
    transition: border-color 0.3s ease; 
  }
  .form-group input:focus { outline: none; border-color: #C5A059; background-color: rgba(255, 255, 255, 0.05); }

  .btn-primary { 
    width: 100%; 
    background-color: transparent;
    color: #C5A059;
    border: 1px solid #C5A059; 
    padding: 1.15rem; 
    font-size: 0.9rem; 
    font-weight: 700; 
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 2px; 
    cursor: pointer; 
    transition: all 0.35s ease; 
  }
  .btn-primary:hover { 
    background-color: #C5A059; 
    color: #0B1120;
  }
  .mt-4 { margin-top: 1.5rem; }

  /* Spinner */
  .spinner-container { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; height: 100%; }
  .spinner { width: 50px; height: 50px; border: 2px solid rgba(197, 160, 89, 0.15); border-radius: 50%; border-top-color: #C5A059; animation: spin 1s linear infinite; }
  .spinner-text { color: #C5A059; font-weight: 600; font-size: 1rem; letter-spacing: 0.05em; animation: pulse 1.5s ease-in-out infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  @keyframes pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }

  .success-icon { color: #C5A059; margin-bottom: 1.5rem; display: flex; justify-content: center; }
  .success-desc { color: #F9FAFB; background: rgba(255,255,255,0.03); padding: 1.5rem; border-radius: 2px; border-left: 3px solid #C5A059; text-align: left; font-size: 0.95rem; }
  
  @media (max-width: 600px) {
    .calc-card { padding: 3rem 2rem; }
    .calc-title { font-size: 1.7rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const card = document.querySelector('.calc-card');
    if (!card) return;

    const waNumber = card.getAttribute('data-wa');
    const btnCalcular = document.getElementById('btn-calcular');
    const btnWhatsapp = document.getElementById('btn-whatsapp');
    
    const step1 = document.getElementById('calc-step-1');
    const step2 = document.getElementById('calc-step-2');
    const step3 = document.getElementById('calc-step-3');

    const inputSueldo = document.getElementById('sueldo') as HTMLInputElement;
    const inputAntiguedad = document.getElementById('antiguedad') as HTMLInputElement;

    let sueldoVal = '';
    let antVal = '';

    btnCalcular.addEventListener('click', () => {
      if (!inputSueldo.value || !inputAntiguedad.value) {
        alert('Por favor, completa ambos campos para generar la estimación.');
        return;
      }
      
      sueldoVal = inputSueldo.value;
      antVal = inputAntiguedad.value;

      // Fase 2: Spinner Psicológico
      step1.classList.remove('active');
      setTimeout(() => {
        step1.style.display = 'none';
        step2.style.display = 'block';
        setTimeout(() => step2.classList.add('active'), 50);
      }, 400);

      // Fase 3: Bloqueo de Información y Redirección tras 2.5s
      setTimeout(() => {
        step2.classList.remove('active');
        setTimeout(() => {
          step2.style.display = 'none';
          step3.style.display = 'block';
          setTimeout(() => step3.classList.add('active'), 50);
        }, 400);
      }, 2500);
    });

    btnWhatsapp.addEventListener('click', () => {
      const formatSueldo = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(Number(sueldoVal));
      const mensaje = `Hola. Utilicé el simulador de indemnización en la web. 
Mi mejor sueldo es ${formatSueldo} y mi antigüedad es de ${antVal} años.
Quisiera recibir la estimación confidencial del cálculo y evaluar mi caso.`;
      
      const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(mensaje)}`;
      window.open(url, '_blank');
    });
  });
</script>
