---
import { estudio } from '../data/estudio.js';
---

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="container hero-content fade-in">
    <p class="hero-subtitle">{estudio.especialidad} &middot; {estudio.zona}</p>
    <h1 class="hero-title">{estudio.slogan}</h1>
    <p class="hero-description">{estudio.descripcion}</p>
    
    <div class="hero-ctas">
      <a href={estudio.whatsappUrl(estudio.mensajesWhatsapp.hero)} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Consultar mi caso por WhatsApp
      </a>
    </div>
    
    <p class="hero-note">✓ Consulta confidencial y sin compromiso</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 8rem 0;
    background-color: var(--navy-deep);
    background-image: url('/images/dike/hero-placeholder.jpg');
    background-size: cover;
    background-position: center;
    color: var(--paper);
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }
  .hero-subtitle {
    color: var(--gold-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  .hero-title {
    color: var(--paper);
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
  }
  .hero-description {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    max-width: 600px;
    color: #e2e8f0;
  }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hero-note {
    font-size: 0.875rem;
    color: #94a3b8;
  }
  @media (max-width: 768px) {
    .hero {
      padding: 5rem 0;
      min-height: auto;
    }
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-ctas {
      flex-direction: column;
    }
  }
</style>
